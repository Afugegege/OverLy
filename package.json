{
  "name": "overly",
  "productName": "overLy",
  "version": "1.0.4",
  "description": "Lightweight floating synced lyrics overlay for Windows",
  "main": "main.js",
  "author": "Afugegege",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Afugegege/OverLy.git"
  },
  "homepage": "https://github.com/Afugegege/OverLy#readme",
  "scripts": {
    "start": "electron .",
    "stop": "taskkill /F /IM electron.exe /T 2>nul || exit 0",
    "restart": "npm stop --if-present && npm start",
    "generate-bitmaps": "electron scripts/generate-bitmaps.js",
    "prebuild": "electron scripts/generate-bitmaps.js",
    "predist": "electron scripts/generate-bitmaps.js",
    "build": "electron-builder --win",
    "dist": "electron-builder --win",
    "dist:zip": "electron-builder --win zip",
    "checksums": "node scripts/generate-checksums.js",
    "postdist": "node scripts/generate-checksums.js",
    "release": "node scripts/publish-release.js"
  },
  "keywords": [
    "lyrics",
    "overlay",
    "spotify",
    "apple-music",
    "smtc",
    "minimalist",
    "floating-lyrics"
  ],
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.afugegege.overly",
    "productName": "overLy",
    "copyright": "Copyright © 2026 Afugegege",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "smtc-service.js",
      "lyrics-service.js",
      "smtc_daemon.ps1",
      "renderer/**/*",
      "assets/**/*",
      "!scripts/**/*",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "smtc_daemon.ps1"
    ],
    "extraResources": [
      {
        "from": "smtc_daemon.ps1",
        "to": "smtc_daemon.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "overLy",
      "uninstallDisplayName": "overLy - Floating Lyrics",
      "runAfterFinish": false,
      "installerSidebar": "assets/installerSidebar.bmp",
      "uninstallerSidebar": "assets/uninstallerSidebar.bmp",
      "installerHeader": "assets/installerHeader.bmp",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "installer.nsh"
    }
  }
}
